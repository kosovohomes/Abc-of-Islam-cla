        "q": "What does Eid al-Adha remember?",
        "options": [
          "Ramadan ending",
          "Ibrahim's willingness to sacrifice his son",
          "The Quran being revealed"
        ],
        "correct": 1,
        "explanation": "Eid al-Adha remembers when Prophet Ibrahim was ready to sacrifice his son for Allah."
      },
